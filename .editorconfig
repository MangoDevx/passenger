root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# ICorDebug, IMetaDataImport and dbgshim declared for the source generators, recovered from ICorDebugSharp
# (THIRD_PARTY_NOTICES.md): analyzers and the comment rules pass over them, as over the generators' own output.
[src/Passenger.Debugger.Interop/**.cs]
generated_code = true
