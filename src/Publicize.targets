<Project>
  <!-- Krafs.Publicizer, made safe for two builds of a project at once, for the projects that reach assemblies' internal
       members (the debugger's engine, Passenger's extension to Roslyn's server): each lists them as Publicize items and
       references the package itself.

       The publicizer's own target, unhooked here, writes each assembly straight to its place in obj and takes any file
       there as finished, so a second build at once (the design-time build a restore starts) could compile against one
       still being written. Each build runs the task in a folder of its own, started from the finished assemblies, and
       moves only whole files into place. -->
  <PropertyGroup>
    <PublicizeBeforeTargets />
  </PropertyGroup>

  <!-- Copies (or moves) the files From has and To lacks, each one whole: a move never replaces a file, so of two builds
       placing the same assembly the first one's stays. Done here rather than by MSBuild's Copy and Move, which on Windows
       refuse a path past 260 characters, as an assembly's publicized path in a deep folder is. -->
  <UsingTask TaskName="PublicizedFiles" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <From Required="true" />
      <To Required="true" />
      <Pattern />
      <Move ParameterType="System.Boolean" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (Directory.Exists(From))
        {
            foreach (string file in Directory.EnumerateFiles(From, string.IsNullOrEmpty(Pattern) ? "*" : Pattern, SearchOption.AllDirectories))
            {
                // Compiled against .NET Standard 2.0, which has no Path.GetRelativePath.
                string target = Path.Combine(To, file.Substring(From.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar));
                if (File.Exists(target))
                {
                    continue;
                }
                Directory.CreateDirectory(Path.GetDirectoryName(target) ?? To);
                try
                {
                    if (Move)
                    {
                        File.Move(file, target);
                    }
                    else
                    {
                        File.Copy(file, target);
                    }
                }
                catch (IOException) when (File.Exists(target))
                {
                    // Another build placed the same file first, whole.
                }
            }
            if (Move)
            {
                try
                {
                    Directory.Delete(From, recursive: true);
                }
                catch (Exception failed) when (failed is IOException || failed is UnauthorizedAccessException)
                {
                    // A virus scanner still reading a copy just made: the folder is only left behind.
                    Log.LogMessage(MessageImportance.Low, $"{From} stays: {failed.Message}");
                }
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PublicizeWhole" DependsOnTargets="ResolveAssemblyReferences" BeforeTargets="ResolveReferences">
    <PropertyGroup>
      <_Publicized>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'PublicizedAssemblies'))</_Publicized>
      <_Publicizing>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'publicizing', '$([System.Guid]::NewGuid().ToString().Substring(0, 8))'))</_Publicizing>
    </PropertyGroup>
    <PublicizedFiles From="$(_Publicized)" To="$(_Publicizing)" Pattern="*.dll" />
    <PublicizeAssemblies ReferencePaths="@(ReferencePath)" Publicizes="@(Publicize)" DoNotPublicizes="@(DoNotPublicize)" OutputDirectory="$(_Publicizing)">
      <Output TaskParameter="ReferencePathsToDelete" ItemName="_PublicizedOriginal" />
      <Output TaskParameter="ReferencePathsToAdd" ItemName="_PublicizedReference" />
    </PublicizeAssemblies>
    <PublicizedFiles From="$(_Publicizing)" To="$(_Publicized)" Move="true" />
    <ItemGroup>
      <_PublicizedReference>
        <Placed>$([System.String]::Copy('%(Identity)').Replace('$(_Publicizing)', '$(_Publicized)'))</Placed>
      </_PublicizedReference>
      <ReferencePath Remove="@(_PublicizedOriginal)" />
      <ReferencePath Include="@(_PublicizedReference->'%(Placed)')" />
      <!-- What the package's target adds, so the runtime lets this assembly reach the members made public. -->
      <AssemblyAttribute Include="System.Runtime.CompilerServices.IgnoresAccessChecksToAttribute">
        <_Parameter1>%(_PublicizedReference.Filename)</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
