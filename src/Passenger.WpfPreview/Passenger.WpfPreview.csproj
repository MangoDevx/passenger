<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF's previewer, Passenger's own: a small WPF program that draws one XAML file of a WPF project as it is typed,
       from the project's last build, run with the machine's dotnet on the project's own runtime configuration and
       dependencies, so it loads the project's assemblies and WPF as the app itself would. Carried on Windows alone,
       where WPF draws. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The oldest .NET a WPF project is supported on, so it runs on any project's runtime from there on. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The user32 calls that let a window be laid out at its size unshown (Surface.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Passenger.WpfPreview</RootNamespace>
    <!-- Run through dotnet exec on the project's runtime configuration; its own (a class library has none, nor does a
         project older than .NET 8 run this) rolls forward to the newest runtime the machine has. -->
    <UseAppHost>false</UseAppHost>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- The runtime's and WPF's variables as Passenger names them. -->
    <Compile Include="../Passenger.Core/RuntimeVariables.cs" Link="RuntimeVariables.cs" />
    <!-- Passenger's requests read as every JSON-lines peer reads its messages. -->
    <Compile Include="../Passenger.Core/JsonLines.cs" Link="JsonLines.cs" />
  </ItemGroup>
</Project>
