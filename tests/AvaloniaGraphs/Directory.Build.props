<Project>
  <!-- The package graph of the Avalonia 11 app the previewer's tests write, at AvaloniaOlderVersion and the tests' own
       target, TestProjects.Framework, restored with the solution so the package cache holds it: a test folder restores
       from the run's local feed alone, never nuget.org. Built as an empty library, never run, under none of the repo's
       rules, which are for Passenger's code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)../../artifacts</ArtifactsPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
